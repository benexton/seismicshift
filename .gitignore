# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
__pycache__/

# Supabase CLI local state (project links, etc.) - machine-specific, not secrets
supabase/.temp/

# CCC flood-extent open-data exports (70-94MB each, ~254MB total) - too large
# for this public repo's git history. scripts/building-stock/build_flood_geojson.mjs
# turns these into the ~25MB public/data/flood-extent.geojson the map actually
# serves, which IS committed. Re-download from CCC's open-data portal to rebuild.
docs/Flood_Extent_*.geojson

# Quake Defender sizing engine - source lives in the private seismicshift-pipeline
# repo (qd-sizing/qdSizing.ts); scripts/sync-qd-engine.mjs copies it in before
# dev/build, so it never gets committed here.
src/lib/qdSizing.ts

# Full-size Seismic Walk photos, moved here by scripts/build-walk-photos.mjs
# once it has written the web-sized public/images/walk/<id>.webp (which IS
# committed). Kept locally only, in case a photo needs re-cropping.
photos/walk-originals/

# Astro CLI's local lastUpdateCheck timestamp - machine/session-specific, no functional content
.astro/settings.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
