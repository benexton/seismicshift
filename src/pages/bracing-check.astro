---
import BaseLayout from '../layouts/BaseLayout.astro'
import BeforeAfterSlider from '../components/BeforeAfterSlider.jsx'

const BRAND = '#17638f'

// Before/after comparison copy - all editable, kept as named constants.
const COMPARISON_HEADING = 'Same house. Same earthquake. Different design.'
const COMPARISON_INTRO = "Building codes are designed to save lives in a significant earthquake, not necessarily to save your home and minimise damage. Drag the slider to see what building to a higher level than the house design rules (NZS 3604) minimum could do for the same room in the same earthquake."
const ROOM_BEFORE_LABEL = 'Standard (code minimum)'
const ROOM_AFTER_LABEL = 'Low-damage (resilient)'
const DETAIL_HEADING = 'The same story, up close'
const DETAIL_INTRO = 'More bracing increases the chances of the framing remaining straight and true. Linings and cladding are more likely to be undamaged, and doors and windows should remain operational.'
const DETAIL_BEFORE_LABEL = ROOM_BEFORE_LABEL
const DETAIL_AFTER_LABEL = ROOM_AFTER_LABEL
const IMAGES_DISCLAIMER = 'Images are for illustrative purposes only and do not depict actual buildings, test results, or engineering analysis.'
const CTA_HEADING = 'How could you build better?'
---

<BaseLayout
  title="Bracing Resilience Check | Seismic Shift"
  description="See how much bracing above the NZS 3604:2011 minimum a stay-livable home needs on your site, and where wind loads already have you covered."
  canonicalPath="/bracing-check/"
>
  <section class="w-full bg-white py-16">
    <div class="max-w-7xl mx-auto px-6 md:px-16">
      <p class="text-xs font-black uppercase tracking-widest text-slate-400 mb-4">Bracing resilience check</p>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-black leading-tight tracking-tighter text-slate-900 mb-10">
        Building codes are designed to save lives.<br />
        <span style={`color:${BRAND}`}>What would it take to save your home too?</span>
      </h1>

      <div class="mb-14">
        <h2 class="text-2xl md:text-3xl font-black tracking-tighter text-slate-900 mb-3">
          {COMPARISON_HEADING}
        </h2>
        <p class="text-slate-500 text-base md:text-lg leading-relaxed mb-8">
          {COMPARISON_INTRO}
        </p>

        <BeforeAfterSlider
          client:load
          beforeSrc="/images/bracing/room-standard.webp"
          afterSrc="/images/bracing/room-resilient.webp"
          beforeAlt="A living room with code-minimum bracing, showing cracked linings and visible damage after an earthquake"
          afterAlt="The same living room with low-damage, resilient bracing, showing intact linings and no visible damage after the same earthquake"
          beforeLabel={ROOM_BEFORE_LABEL}
          afterLabel={ROOM_AFTER_LABEL}
          aspectRatio="16 / 9"
        />
        <p class="text-xs text-slate-400 leading-relaxed mt-3">{IMAGES_DISCLAIMER}</p>

        <div class="mt-12 max-w-xl">
          <h3 class="text-2xl md:text-3xl font-black tracking-tighter text-slate-900 mb-3">
            {DETAIL_HEADING}
          </h3>
          <p class="text-slate-500 text-base md:text-lg leading-relaxed mb-6">
            {DETAIL_INTRO}
          </p>

          <BeforeAfterSlider
            client:visible
            beforeSrc="/images/bracing/corner-standard.webp"
            afterSrc="/images/bracing/corner-resilient.webp"
            beforeAlt="A door corner with standard framing, showing cracked linings and a jammed door after an earthquake"
            afterAlt="The same door corner with low-damage framing, showing an intact, square frame and working door after the same earthquake"
            beforeLabel={DETAIL_BEFORE_LABEL}
            afterLabel={DETAIL_AFTER_LABEL}
            aspectRatio="3 / 2"
          />
          <p class="text-xs text-slate-400 leading-relaxed mt-3">{IMAGES_DISCLAIMER}</p>
        </div>
      </div>

      <div class="mb-6">
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-black leading-tight tracking-tighter" style={`color:${BRAND}`}>
          {CTA_HEADING}
        </h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <a
          href="/bracing-check/homeowner/"
          class="group text-left rounded-3xl border-2 border-slate-100 bg-white hover:border-[#17638f]/40 hover:shadow-md transition motion-reduce:transition-none p-7 md:p-9 focus:outline-none focus:ring-2 focus:ring-[#17638f]/30"
        >
          <p class="text-xs font-black uppercase tracking-widest mb-3" style={`color:${BRAND}`}>Homeowner</p>
          <h2 class="text-2xl md:text-3xl font-black tracking-tighter text-slate-900 leading-tight mb-2">
            I&rsquo;m looking to build a home
          </h2>
          <p class="text-slate-500 text-base leading-relaxed">
            Get a provisional, location-based indication - no bracing figures needed.
          </p>
          <span class="inline-flex items-center gap-2 mt-5 text-sm font-bold tracking-wide" style={`color:${BRAND}`}>
            Get started
            <span aria-hidden="true" class="inline-block transition motion-reduce:transition-none group-hover:translate-x-0.5">&rarr;</span>
          </span>
        </a>

        <a
          href="/bracing-check/designer/"
          class="group text-left rounded-3xl border-2 border-slate-100 bg-white hover:border-[#17638f]/40 hover:shadow-md transition motion-reduce:transition-none p-7 md:p-9 focus:outline-none focus:ring-2 focus:ring-[#17638f]/30"
        >
          <p class="text-xs font-black uppercase tracking-widest mb-3" style={`color:${BRAND}`}>Designer</p>
          <h2 class="text-2xl md:text-3xl font-black tracking-tighter text-slate-900 leading-tight mb-2">
            I&rsquo;m a designer working on a new home or renovation project
          </h2>
          <p class="text-slate-500 text-base leading-relaxed">
            Enter your NZS 3604 bracing units for the specific picture on your site.
          </p>
          <span class="inline-flex items-center gap-2 mt-5 text-sm font-bold tracking-wide" style={`color:${BRAND}`}>
            Get started
            <span aria-hidden="true" class="inline-block transition motion-reduce:transition-none group-hover:translate-x-0.5">&rarr;</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="w-full bg-slate-50 border-t border-slate-100 py-16">
    <div class="max-w-7xl mx-auto px-6 md:px-16">
      <p class="text-xs font-black text-slate-500 mb-3">Disclaimer</p>
      <p class="text-sm text-slate-400 leading-relaxed">
        This tool indicates relative demand, not a design specification. Any build requires specific engineering consideration. Preliminary information only, not professional engineering, legal, or insurance advice. Figures shown throughout this page are illustrative placeholders, not final figures. The moderate, high and extreme shift bands are illustrative cutoffs, not final thresholds. Worked-example bracing units for the curated locations, and baseline estimates for every other location, are placeholders too, not location-specific NZS 3604 calculations. The SR337 uplift factor is set from the recommendations in BRANZ SR337 for what it might take to achieve a low damage outcome. Based on an interpretation of currently available information which is subject to change at any point.
      </p>
    </div>
  </section>
</BaseLayout>
