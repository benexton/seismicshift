---
import BaseLayout from '../layouts/BaseLayout.astro'

const BRAND = '#17638f'
---

<BaseLayout
  title="Bracing Resilience Check | Seismic Shift"
  description="See how much bracing above the NZS 3604:2011 minimum a stay-livable home needs on your site, and where wind loads already have you covered."
  canonicalPath="/bracing-check/"
>
  <section class="w-full bg-white py-16">
    <div class="max-w-7xl mx-auto px-6 md:px-16">
      <div class="flex items-start justify-between gap-4 mb-4">
        <p class="text-xs font-black uppercase tracking-widest text-slate-400">Bracing resilience check</p>
        <span class="shrink-0 text-[0.62rem] font-black uppercase tracking-widest text-[#c07c1c] bg-[#f6edd9] border border-[#e6d3a8] rounded-full px-2.5 py-1">
          Prototype: illustrative figures
        </span>
      </div>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-black leading-tight tracking-tighter text-slate-900 mb-10">
        Building codes are designed to save lives.<br />
        <span style={`color:${BRAND}`}>What would it take to save your home too?</span>
      </h1>

      <div class="grid gap-4 sm:grid-cols-2">
        <a
          href="/bracing-check/homeowner/"
          class="group text-left rounded-3xl border-2 border-slate-100 bg-white hover:border-[#17638f]/40 hover:shadow-md transition motion-reduce:transition-none p-7 md:p-9 focus:outline-none focus:ring-2 focus:ring-[#17638f]/30"
        >
          <p class="text-xs font-black uppercase tracking-widest mb-3" style={`color:${BRAND}`}>Homeowner</p>
          <h2 class="text-2xl md:text-3xl font-black tracking-tighter text-slate-900 leading-tight mb-2">
            I&rsquo;m looking to build a home
          </h2>
          <p class="text-slate-500 text-base leading-relaxed">
            Get a provisional, location-based indication - no bracing figures needed.
          </p>
          <span class="inline-flex items-center gap-2 mt-5 text-sm font-bold tracking-wide" style={`color:${BRAND}`}>
            Get started
            <span aria-hidden="true" class="inline-block transition motion-reduce:transition-none group-hover:translate-x-0.5">&rarr;</span>
          </span>
        </a>

        <a
          href="/bracing-check/designer/"
          class="group text-left rounded-3xl border-2 border-slate-100 bg-white hover:border-[#17638f]/40 hover:shadow-md transition motion-reduce:transition-none p-7 md:p-9 focus:outline-none focus:ring-2 focus:ring-[#17638f]/30"
        >
          <p class="text-xs font-black uppercase tracking-widest mb-3" style={`color:${BRAND}`}>Designer</p>
          <h2 class="text-2xl md:text-3xl font-black tracking-tighter text-slate-900 leading-tight mb-2">
            I&rsquo;m a designer working on a new home or renovation project
          </h2>
          <p class="text-slate-500 text-base leading-relaxed">
            Enter your NZS 3604 bracing units for the specific picture on your site.
          </p>
          <span class="inline-flex items-center gap-2 mt-5 text-sm font-bold tracking-wide" style={`color:${BRAND}`}>
            Get started
            <span aria-hidden="true" class="inline-block transition motion-reduce:transition-none group-hover:translate-x-0.5">&rarr;</span>
          </span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
