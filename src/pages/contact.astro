---
import BaseLayout from '../layouts/BaseLayout.astro'
import ContactForm from '../components/ContactForm.jsx'

const BRAND = '#17638f'

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Seismic Shift Ltd",
  "url": "https://www.seismicshift.nz",
  "email": "info@seismicshift.nz",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Level 1, 829 Colombo Street",
    "addressLocality": "Christchurch",
    "addressRegion": "Canterbury",
    "postalCode": "8013",
    "addressCountry": "NZ"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -43.5254,
    "longitude": 172.6365
  },
  "areaServed": ["New Zealand", "United States", "Canada", "Japan", "Chile"],
  "description": "Earthquake protection technology for commercial buildings, homes, and critical equipment."
}
---

<BaseLayout
  title="Contact Seismic Shift | Get in Touch"
  description="Get in touch with Seismic Shift's engineering team. Free consultations for commercial buildings, homes, and critical equipment protection."
  canonicalPath="/contact/"
  schema={schema}
  includeTurnstile={true}
>
  <div class="min-h-screen bg-slate-50">
    <div class="max-w-7xl mx-auto px-8 md:px-16 py-8 md:py-12">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-black tracking-tighter text-slate-900 mb-10 md:mb-16">
        We'd love to speak with you.
      </h1>
      <div class="grid lg:grid-cols-2 gap-16 items-stretch">
        <ContactForm client:load />
        <div class="rounded-3xl overflow-hidden border border-slate-200 shadow-sm min-h-[480px]">
          <iframe
            title="Seismic Shift Location"
            src="https://www.google.com/maps?q=Seismic+Shift,+Level+1/829+Colombo+Street,+Christchurch+8013&z=16&output=embed"
            width="100%"
            height="100%"
            style="border:0;min-height:480px"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
