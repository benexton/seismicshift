---
import BaseLayout from '../../layouts/BaseLayout.astro'
import QdSizingCalculator from '../../components/QdSizingCalculator.jsx'

const BRAND = '#17638f'
---

<!-- Unlinked and noindex until the Quake Defender methodology (draft V26.10) is
     published - also excluded from the sitemap in astro.config.mjs. When it
     goes live: drop noindex, remove the sitemap filter, and add the page to
     Nav.astro, llms.txt.ts and a cross-link on quake-defender.astro. -->
<BaseLayout
  title="Quake Defender Sizing Calculator | Seismic Shift"
  description="Size a Quake Defender device and DonoBrace brace from the results of your initial DonoBrace-only model, with the Step 3 locking and Step 4 one-point checks."
  canonicalPath="/quake-defender/sizing-calculator/"
  noindex
>
  <section class="w-full bg-white py-16">
    <div class="max-w-7xl mx-auto px-6 md:px-16">
      <p class="text-xs font-black uppercase tracking-widest text-slate-400 mb-4">Quake Defender sizing calculator</p>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-black leading-tight tracking-tighter text-slate-900 mb-6">
        Size the Quake Defender.<br />
        <span style={`color:${BRAND}`}>Straight from your elastic model.</span>
      </h1>

      <p class="text-lg text-slate-500 leading-relaxed">
        Apply a 0.1g equivalent static case to an elastic, DonoBrace-only model of the building, enter the results, and the calculator picks the smallest QD and DonoBrace pair that passes the Step 3 locking checks and the Step 4 one-point checks. <strong class="text-slate-900">This page is for sizing only:</strong> re-run your model with the chosen size and complete the full design in your own calculations.
      </p>

      <div class="mt-10">
        <QdSizingCalculator client:load />
      </div>
    </div>
  </section>

  <section class="w-full bg-slate-50 border-t border-slate-100 py-16">
    <div class="max-w-7xl mx-auto px-6 md:px-16">
      <p class="text-xs font-black text-slate-500 mb-3">Disclaimer</p>
      <p class="text-sm text-slate-400 leading-relaxed">
        For sizing only. Single-storey structures under 15 m with DonoBrace tension-only bracing, to NZS 1170.5:2004. Enter the critical brace for each direction or side. Brace lines resisting the same direction are assumed to activate together. For roof-plane bracing the results are indicative only; the pushover of your model governs. Uses the proposed full-loop product table and the draft Quake Defender methodology V26.10. Not a Producer Statement or code opinion; the PS1 signatory remains responsible for the design.
      </p>
    </div>
  </section>
</BaseLayout>
